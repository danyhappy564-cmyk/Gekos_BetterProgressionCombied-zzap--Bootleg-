<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GekosBetterProgression</RootNamespace>
    <AssemblyName>GekosBetterProgression</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>3.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Reflection" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json5" CopyToOutputDirectory="Always" />
    <None Update="advancedConfig.json5" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- Drop the built mod straight into the server's user\mods folder. -->
  <Target Name="DeployToSpt" AfterTargets="Build" Condition=" '$(DeployToSpt)' != 'false' AND Exists('$(SptRoot)') ">
    <PropertyGroup>
      <SptModDir>$(SptRoot)\SPT_Runtime\user\mods\Gekos_BetterProgression\</SptModDir>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFiles="@(DeployFiles->'$(SptModDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(AssemblyName) to $(SptModDir)" />
  </Target>


  <!--
    Rule 2-2: every Release build also drops a ready-to-ship archive in release/.
    Skip with -p:SkipPackage=true.
  -->
  <Target Name="PackageRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipPackage)' != 'true'">
    <PropertyGroup>
      <PackageStageDir>$(IntermediateOutputPath)package\</PackageStageDir>
      <PackageZipDir>$(MSBuildThisFileDirectory)release\</PackageZipDir>
      <PackageZipPath>$(PackageZipDir)$(AssemblyName)-$(Version).zip</PackageZipPath>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="@(PackageFiles)"
          DestinationFiles="@(PackageFiles->'$(PackageStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(PackageZipDir)" />
    <Delete Files="$(PackageZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <Message Text="Packaged $(PackageZipPath)" Importance="high" />
  </Target>

</Project>
